{
  "name": "dsh-workspace-api",
  "version": "1.0.2",
  "description": "DSH 插件：把 workspace 内容与 DSH agent 任务能力暴露为 HTTP API（/workspace-api/*），其他程序可查询目录、搜索文件、提交自然语言任务给 agent 处理。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace-api",
    "http-api",
    "agent-task"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --check lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liaoyonghong/dsh-workspace-api.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/liaoyonghong/dsh-workspace-api#readme",
  "bugs": {
    "url": "https://github.com/liaoyonghong/dsh-workspace-api/issues"
  },
  "author": {
    "name": "liaoyonghong",
    "url": "https://github.com/liaoyonghong"
  }
}
